+}
+
+function syntaxLines(
+  text: string,
+  flagged: readonly string[],
+  syntax: CommandSyntax,
+): string[] | undefined {
+  const plain = text.split("\n");
+  const coloured = syntax(text);
+  if (
+    coloured.length !== plain.length ||
+    coloured.some((line, index) => stripAnsi(line) !== plain[index])
+  ) {
+    return undefined;
+  }
+  const needles = flagged.filter((needle) => needle !== text);
+  return coloured.map((line, index) =>
+    markRanges(line, tokenRanges(plain[index] ?? "", needles)),
+  );
+}
+
+const ANSI = /\x1b\[[0-9;]*m/g;
+
+function stripAnsi(text: string): string {
+  return text.replace(ANSI, "");
+}
+
+function tokenRanges(
+  line: string,
+  needles: readonly string[],
+): [number, number][] {
+  const ranges: [number, number][] = [];
+  for (const needle of needles) {
+    if (needle === "" || needle.includes("\n")) continue;
+    for (
+      let at = line.indexOf(needle);
+      at !== -1;
+      at = line.indexOf(needle, at + needle.length)
+    ) {
+      const end = at + needle.length;
+      if (
+        !TOKEN_CHARACTER.test(line[at - 1] ?? " ") &&
+        !TOKEN_CHARACTER.test(line[end] ?? " ")
+      ) {
+        ranges.push([at, end]);
+      }
+    }
+  }
+  return ranges;
+}
+
+function markRanges(line: string, ranges: readonly [number, number][]): string {
+  if (ranges.length === 0) return line;
+  let out = "";
+  let visible = 0;
+  for (let i = 0; i < line.length; ) {
+    const escape = /^\x1b\[[0-9;]*m/.exec(line.slice(i));
+    if (escape) {
+      out += escape[0];
+      i += escape[0].length;
+      continue;
+    }
+    if (ranges.some(([start]) => start === visible)) out += MARK_OPEN;
+    out += line[i];
+    i++;
+    visible++;
+    if (ranges.some(([, end]) => end === visible)) out += MARK_CLOSE;
+  }
+  return out;
 }
 
