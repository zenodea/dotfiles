[color "decorate"]
	HEAD = bold cyan italic
	branch = bold green italic
	remoteBranch = bold red italic
	tag = bold yellow italic
	stash = bold magenta italic
[color "diff"]
	func = italic
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = dotfiles
	navigate = true
	line-numbers = true
	file-style = italic
	file-decoration-style = ol ul
	hunk-header-style = line-number syntax italic
	hunk-header-decoration-style = omit
	commit-style = italic
	minus-style = normal italic "#3f0001"
	minus-emph-style = normal italic "#901011"
