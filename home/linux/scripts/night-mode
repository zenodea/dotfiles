#!/bin/bash
# Toggle hyprsunset between a warm night temperature and neutral (off).

NIGHT_TEMP=4000
DAY_TEMP=6500

pgrep -x hyprsunset > /dev/null || { hyprsunset & sleep 0.3; }

current=$(hyprctl hyprsunset temperature 2>/dev/null)
if [ "$current" = "$NIGHT_TEMP" ]; then
    hyprctl hyprsunset temperature "$DAY_TEMP" > /dev/null
else
    hyprctl hyprsunset temperature "$NIGHT_TEMP" > /dev/null
fi
