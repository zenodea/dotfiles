#!/usr/bin/env bash
# dotfiles — CLI entry point for this repo (linked into ~/.local/bin by install.sh)
set -e

# Resolve symlinks so the repo is found when invoked via ~/.local/bin/dotfiles
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DOTFILES="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# shellcheck source=../lib/common.sh
source "$DOTFILES/lib/common.sh"
for part in wallpaper fonts themes appearance maintenance doctor; do
    # shellcheck source=/dev/null
    source "$DOTFILES/lib/dotfiles/$part.sh"
done

usage() {
    cat <<EOF
Usage: dotfiles <command>

Themes:
  --theme <name>, -t   Switch theme (regenerates configs, live-reloads apps)
  --theme              List available themes
  --pick, -p           Pick a theme interactively (fzf if available)
  --random, -r         Switch to a random theme
  --list, -l           List available themes
  --current, -c        Print the active theme

Light / dark:
  --auto [on|off]      Follow the system's light/dark setting (default: status)
  --sync-appearance    Apply the right variant for right now (what the timer runs)

Font:
  --font <name>, -f    Switch font (regenerates configs, live-reloads apps)
  --font               List available fonts
  --text-font <name>, -T
                       Switch the proportional (UI/prose) font independently
  --text-font          List available text fonts

Wallpaper:
  --wallpaper <name|random>, -w
                       Set wallpaper only (no theme change)
  --wallpaper          List available wallpapers

Maintenance:
  --update, -u         git pull, then re-apply the current theme
  --doctor, -d         Check symlinks, dependencies, and config drift
  --sync               Re-run install.sh (symlink configs)
  --save [msg]         git add + commit + push the repo
  --help, -h           Show this help
EOF
}

# --- dispatch ----------------------------------------------------------------

case "${1:-}" in
    --theme|-t)
        if [[ -n "${2:-}" ]]; then
            apply_theme "$2"
        else
            exec "$DOTFILES/bin/switch-theme" --list
        fi
        ;;
    --auto)
        cmd_auto "${2:-status}"
        ;;
    --sync-appearance)
        cmd_sync_appearance
        ;;
    --list|-l)
        exec "$DOTFILES/bin/switch-theme" --list
        ;;
    --current|-c)
        current_theme
        ;;
    --pick|-p)
        cmd_pick
        ;;
    --random|-r)
        cmd_random
        ;;
    --font|-f)
        cmd_font "${2:-}"
        ;;
    --text-font|-T)
        cmd_text_font "${2:-}"
        ;;
    --wallpaper|-w)
        cmd_wallpaper "${2:-}"
        ;;
    --update|-u)
        cmd_update
        ;;
    --doctor|-d)
        cmd_doctor
        ;;
    --sync)
        exec "$DOTFILES/install.sh"
        ;;
    --save)
        cmd_save "${2:-}"
        ;;
    --themes-plain)
        # Plain lists, one per line (used by zsh completion)
        theme_names
        ;;
    --wallpapers-plain)
        wallpaper_names
        ;;
    --fonts-plain)
        font_names
        ;;
    --text-fonts-plain)
        text_font_names
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac
