#!/usr/bin/env bash
# brew — install everything in the Brewfile next to this script, then the
# Raycast extension's npm dependencies. Safe to rerun: brew bundle skips what's
# already installed.
set -e

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../.." && pwd)"

has() { command -v "$1" &> /dev/null; }

# ── Bootstrap Homebrew ───────────────────────────────────────────────────────

if ! has brew; then
    echo "==> Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# The installer doesn't touch the current shell's PATH.
if ! has brew; then
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"   # Apple silicon
    else
        eval "$(/usr/local/bin/brew shellenv)"      # Intel
    fi
fi

# ── Packages ─────────────────────────────────────────────────────────────────

echo "==> Installing from the Brewfile..."
# --adopt takes over apps that were installed by hand (dragged in from a .dmg)
# instead of failing because the .app is already there.
HOMEBREW_CASK_OPTS="${HOMEBREW_CASK_OPTS:+$HOMEBREW_CASK_OPTS }--adopt" \
    brew bundle --file="$here/Brewfile"

# ── Raycast extension ────────────────────────────────────────────────────────

# Only the dependencies: loading the extension into Raycast needs Raycast set
# up first, so that step is on the checklist bootstrap.sh prints.
ext="$root/apps/mac/raycast/extension"
if [ -f "$ext/package-lock.json" ] && [ ! -d "$ext/node_modules" ]; then
    echo "==> Installing the Raycast extension's dependencies..."
    (cd "$ext" && npm ci --no-audit --no-fund)
fi

# ── AeroSpace ────────────────────────────────────────────────────────────────

# AeroSpace is a .app, not a brew service; it starts itself at login only if its
# own config says so. That config lives in apps/mac/aerospace/.
if ! grep -q "^start-at-login = true" "$root/apps/mac/aerospace/config/aerospace.toml" 2> /dev/null; then
    echo "    note: aerospace won't start at login — set start-at-login = true"
    echo "          in apps/mac/aerospace/config/aerospace.toml to change that"
fi

echo "Done. Run ./install.sh next to link the configs and render a theme."
