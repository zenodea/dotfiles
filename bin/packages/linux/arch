#!/usr/bin/env bash
# arch — install every package the Linux setup needs (Arch, via pacman + yay)
set -e

# ── Helpers ──────────────────────────────────────────────────────────────────

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

# ── AUR opt-in ───────────────────────────────────────────────────────────────

AUR=""
for arg in "$@"; do
    case "$arg" in
        --aur) AUR=1 ;;
        --no-aur) AUR=0 ;;
        *) echo "usage: arch [--aur|--no-aur]" >&2; exit 1 ;;
    esac
done
if [ -z "$AUR" ]; then
    AUR=0
    if [ -t 0 ]; then
        read -r -p "Install AUR packages with yay? [y/N] " answer
        case "$answer" in y|Y|yes|YES) AUR=1 ;; esac
    fi
fi

if [ "$AUR" = 1 ] && ! has yay; then
    echo "==> Installing yay (AUR helper)..."
    sudo pacman -S --needed --noconfirm git base-devel
    tmp=$(mktemp -d)
    git clone https://aur.archlinux.org/yay.git "$tmp/yay"
    (cd "$tmp/yay" && makepkg -si --noconfirm)
    rm -rf "$tmp"
fi

# ── Pacman packages ───────────────────────────────────────────────────────────

PACMAN_PACKAGES=(
    # Hyprland stack
    hyprland
    xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk
    xdg-utils
    polkit-kde-agent

    # Idle / lock / wallpaper / blue light
    hypridle
    hyprlock
    hyprsunset
    awww

    # Status bar + what its modules call
    quickshell
    waybar
    playerctl
    blueman
    networkmanager
    power-profiles-daemon
    libnotify

    # Launchers
    fuzzel
    rofi

    # What the quickshell panels reach for
    wf-recorder
    libheif
    pacman-contrib

    # Terminal
    ghostty

    # File managers
    vifm
    yazi

    # yazi extras: video thumbnails, PDF previews, file search, fuzzy jump,
    # frecency jump
    ffmpeg
    poppler
    fd
    fzf
    zoxide

    zsh-autosuggestions
    zsh-syntax-highlighting

    # Terminal multiplexer
    tmux

    # Audio (Pipewire)
    pipewire
    pipewire-pulse
    wireplumber
    pavucontrol

    # Brightness
    brightnessctl

    # Screenshot / clipboard
    grim
    slurp
    wl-clipboard

    # Bluetooth
    bluez
    bluez-utils

    # VPN
    mullvad-vpn

    # Browser
    firefox

    # Editors
    neovim
    zed
    obsidian

    # Editor tooling (mason/treesitter builds, jq for json formatting)
    base-devel
    nodejs
    npm
    go
    unzip
    jq

    # Git tooling
    git
    lazygit
    git-delta
    bat
    github-cli

    # Shell
    zsh

    # Theme engine (envsubst for template rendering, gsettings for GTK scheme)
    gettext
    glib2

    # Fonts (Nerd Font symbols for waybar icons)
    ttf-nerd-fonts-symbols
    noto-fonts
    noto-fonts-emoji
    inter-font
    ttf-ibm-plex
    ttc-iosevka
    ttc-iosevka-aile

    # Misc
    pyenv
    steam
    discord
    spotify-launcher
)

echo "==> Installing pacman packages..."
sudo pacman -S --needed --noconfirm "${PACMAN_PACKAGES[@]}"

# ── AUR packages ─────────────────────────────────────────────────────────────

AUR_PACKAGES=(
    bibata-cursor-theme  # cursor theme
    oh-my-zsh-git        # zsh framework
    otf-commit-mono      # font
)

if [ "$AUR" = 1 ]; then
    echo "==> Installing AUR packages..."
    yay -S --needed --noconfirm "${AUR_PACKAGES[@]}"
else
    echo "==> Skipping AUR; fetching the same things from upstream..."
    install_bibata
    install_oh_my_zsh
    install_commit_mono
fi

# ── Post-install ─────────────────────────────────────────────────────────────

install_herdr
enable_services

echo "Done. Run ./install.sh next to link your dotfiles and render the theme."
