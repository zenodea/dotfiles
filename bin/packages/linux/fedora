#!/usr/bin/env bash
# fedora — install every package the Linux setup needs (Fedora, via dnf + COPR)
set -e

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

# ── Extra repos ──────────────────────────────────────────────────────────────

echo "==> Enabling COPRs and third-party repos..."
sudo dnf install -y dnf-plugins-core

# Fedora retired its hyprland package, so the whole Hyprland stack (hyprland,
# its portal, hyprlock, hypridle, hyprsunset) comes from this COPR, a maintained
# fork of solopasha's. It builds for x86_64 and aarch64.
sudo dnf copr enable -y sdegler/hyprland
sudo dnf copr enable -y scottames/ghostty
sudo dnf copr enable -y lihaohong/yazi
sudo dnf copr enable -y atim/lazygit

# RPM Fusion — full ffmpeg, and steam on x86_64
sudo dnf install -y \
    "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

# Workstation ships Fedora's cut-down ffmpeg-free, which conflicts with RPM
# Fusion's full ffmpeg, so swap it rather than install alongside.
if rpm -q ffmpeg-free &> /dev/null; then
    sudo dnf swap -y ffmpeg-free ffmpeg --allowerasing
else
    sudo dnf install -y ffmpeg
fi

# Mullvad
sudo dnf config-manager addrepo --overwrite \
    --from-repofile=https://repository.mullvad.net/rpm/stable/mullvad.repo

# ── Packages ─────────────────────────────────────────────────────────────────

PACKAGES=(
    # Hyprland stack
    hyprland
    xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk
    xdg-utils

    # Idle / lock / blue light (wallpaper daemon awww is built below)
    hypridle
    hyprlock
    fprintd
    hyprsunset

    # Bar, launcher and panels (apps/linux/quickshell); waybar is the fallback
    quickshell
    waybar
    playerctl
    blueman
    NetworkManager
    NetworkManager-tui
    # Any power-profiles provider: Workstation ships tuned-ppd, which conflicts
    # with power-profiles-daemon but offers the same service to waybar.
    ppd-service
    libnotify

    # Launchers
    fuzzel
    rofi-wayland

    # Terminal
    ghostty

    # File managers
    vifm
    yazi

    # yazi extras (ffmpeg installed above): video thumbnails, PDF previews, file search, fuzzy jump,
    # frecency jump
    poppler-utils
    fd-find
    fzf
    zoxide

    zsh-autosuggestions
    zsh-syntax-highlighting

    # Terminal multiplexer
    tmux

    # Audio (Pipewire)
    pipewire
    pipewire-pulseaudio
    wireplumber
    pavucontrol

    # Brightness
    brightnessctl

    # Screenshot / clipboard
    grim
    slurp
    wl-clipboard

    # Bluetooth
    bluez

    # VPN
    mullvad-vpn

    # Browser
    firefox

    # pi's figure tool: a headless browser draws the picture, ImageMagick crops it
    chromium
    ImageMagick

    # Editors (zed is installed via upstream script below)
    neovim

    # Editor tooling (mason/treesitter builds, jq for json formatting)
    gcc
    gcc-c++
    make
    nodejs
    npm
    golang
    unzip
    jq

    # Git tooling
    git
    lazygit
    git-delta
    bat
    gh

    # System monitor
    btop

    # Shell
    zsh
    fish
    nushell

    # Theme engine (envsubst for template rendering, gsettings for GTK scheme)
    gettext-envsubst
    glib2

    # Fonts (Nerd Font symbols installed below)
    google-noto-sans-fonts
    google-noto-color-emoji-fonts
    rsms-inter-fonts
    ibm-plex-sans-fonts
    fontconfig

    # Misc (pyenv isn't packaged for Fedora; it's installed below)
    cargo
    flatpak
)

# Steam only exists for x86_64, so an ARM machine (or VM) goes without it.
if [ "$(uname -m)" = x86_64 ]; then
    PACKAGES+=(steam)
fi

echo "==> Installing packages..."
sudo dnf install -y "${PACKAGES[@]}"

# ── Not packaged ─────────────────────────────────────────────────────────────

install_awww
install_nerd_symbols
install_iosevka
install_commit_mono
install_bibata
install_oh_my_zsh
install_zed
install_herdr
install_pyenv
install_flatpaks

enable_services
configure_power_key
enroll_fingerprint

echo "Done. Run ./install.sh next to link your dotfiles and render the theme."
