#!/usr/bin/env bash
# switch-theme — render every app's config from a theme's palette, then
# live-reload whatever is running.
#
# Each app is a directory, apps/<general|mac|linux>/<name>/, holding:
#
#   app.sh       render() writes its config(s); reload() pokes the running app
#   templates/   the templated configs render() draws from
#   config/      static config, symlinked to ~/.config/<name> by install.sh
#
# Apps under general/ run on every platform; mac/ and linux/ only run on
# theirs. A general app whose reload differs per OS defines reload_mac and
# reload_linux instead of reload. Each app is sourced in its own subshell, so
# helper functions and state stay local to it.
set -e

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
THEMES_DIR="$DOTFILES/themes"
APPS_DIR="$DOTFILES/apps"
export DOTFILES
export PATH="$HOME/.local/bin:$PATH"

# shellcheck source=lib/common.sh
source "$DOTFILES/lib/common.sh"

# --- theme selection -------------------------------------------------------

list_themes() {
    local current name
    current="$(current_theme)"

    echo "Available themes:"
    while IFS= read -r name; do
        if [[ "$name" == "$current" ]]; then
            echo "  $name (active)"
        else
            echo "  $name"
        fi
    done < <(theme_names)
}

RELOAD=1
ARGS=()
for _arg in "$@"; do
    case "$_arg" in
        --no-reload) RELOAD=0 ;;
        *)           ARGS+=("$_arg") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [[ -z "${1:-}" || "$1" == "--list" || "$1" == "-l" ]]; then
    echo "Usage: switch-theme <theme> [--no-reload]"
    echo ""
    list_themes
    exit 0
fi

THEME="$1"
THEME_FILE="$THEMES_DIR/$THEME.sh"

if [[ ! -f "$THEME_FILE" ]]; then
    echo "Error: theme '$THEME' not found"
    echo ""
    list_themes
    exit 1
fi

# --- palette ---------------------------------------------------------------

# Every color a theme defines. Each one also gets a <COLOR>_RGB ("r, g, b")
# form, derived below — some config formats want decimal channels.
PALETTE=(BG SURFACE BG_ALT BORDER MUTED FG FG_BRIGHT ACCENT BLUE RED GREEN YELLOW ORANGE PURPLE)

# Non-color fields a theme sets, plus the ones this script derives.
THEME_FIELDS=(NVIM_PLUGIN NVIM_COLORSCHEME GHOSTTY_THEME VIFM_COLORSCHEME OPACITY)
DERIVED=(THEME_NAME THEME_APPEARANCE ZED_BASE OPACITY_HEX ACCENT_H ACCENT_S ACCENT_L)

# shellcheck source=/dev/null
set -a
source "$THEME_FILE"
set +a

export THEME_NAME="$THEME"
THEME_APPEARANCE="$(appearance_of "$BG")"
export THEME_APPEARANCE

# Terminal transparency, and the Zed base theme the settings.json overrides sit
# on top of — both follow from light vs dark, so a theme need only override the
# odd one out. Zed's base only has to get the bits the overrides don't reach
# right (scrollbars, icon variants), so two built-ins beat a per-theme name.
if [[ "$THEME_APPEARANCE" == "light" ]]; then
    export OPACITY="${OPACITY:-0.85}"       # 0.7 over a light palette just goes grey
    export ZED_BASE="One Light"
else
    export OPACITY="${OPACITY:-0.7}"       # 0.7 over a dark palette
    export ZED_BASE="One Dark"
fi

# Same transparency, for the configs that want an alpha byte on a hex color
# rather than a fraction of their own. A surface that sets its own alpha reads
# as a different color than the terminal next to it, because what shows through
# is the wallpaper — so anything painting BG as a window background should take
# this, and track light/dark for free.
OPACITY_HEX="$(awk -v o="$OPACITY" 'BEGIN { printf "%02x", int(o * 255 + 0.5) }')"
export OPACITY_HEX

# A light half with no wallpaper of its own shares the dark half's.
if [[ -z "${WALLPAPER:-}" && "$THEME" == *-light ]]; then
    WALLPAPER="$(theme_field "$(theme_base "$THEME")" WALLPAPER)"
fi
export WALLPAPER

# Light palettes are mostly dark ones turned inside out, and their accents are
# picked for looks: across the light themes about half of them sit under 4.5:1
# against their own BG, and the yellows land near 2:1. Every app renders these
# hexes as text (tmux, lazygit, pi, zed, sketchybar), so fix them here, once,
# rather than in each app. Each color is darkened in Oklab: lightness drops
# until it clears 4.5:1, hue stays put, and chroma only gives way where the
# darker color would leave sRGB. A yellow comes out as a deeper yellow-brown of
# the same hue, not the muddy olive a mix toward black gives. Colors that
# already read are left exactly as the theme set them. Dark palettes are left
# alone; their accents already read.
legible() { # legible <rrggbb> <bg> <ratio>
    awk -v h="$1" -v bg="$2" -v want="$3" '
        function hex(s, i) { return index("0123456789abcdef", tolower(substr(s, i, 1))) * 16 + index("0123456789abcdef", tolower(substr(s, i + 1, 1))) - 17 }
        function lin(c) { c /= 255; return (c <= 0.04045) ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
        function enc(c) { return (c <= 0.0031308) ? 12.92 * c : 1.055 * c ^ (1 / 2.4) - 0.055 }
        function cbrt(x) { return (x < 0) ? -((-x) ^ (1 / 3)) : x ^ (1 / 3) }
        function lum(r, g, b) { return 0.2126 * r + 0.7152 * g + 0.0722 * b }
        function ratio(a, b) { return (a > b) ? (a + 0.05) / (b + 0.05) : (b + 0.05) / (a + 0.05) }
        # Oklab (L, C, hue) -> linear sRGB in R G B; returns 1 when in gamut.
        function torgb(L, C,   a, b, l, m, s) {
            a = C * cos(H); b = C * sin(H)
            l = (L + 0.3963377774 * a + 0.2158037573 * b) ^ 3
            m = (L - 0.1055613458 * a - 0.0638541728 * b) ^ 3
            s = (L - 0.0894841775 * a - 1.2914855480 * b) ^ 3
            R =  4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
            G = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
            B = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
            return R >= 0 && R <= 1 && G >= 0 && G <= 1 && B >= 0 && B <= 1
        }
        # Hex at lightness L, chroma bisected down until it fits sRGB.
        function at(L,   lo, hi, c, i) {
            if (!torgb(L, C0)) {
                lo = 0; hi = C0
                for (i = 0; i < 20; i++) { c = (lo + hi) / 2; if (torgb(L, c)) lo = c; else hi = c }
                torgb(L, lo)
            }
            return sprintf("%02x%02x%02x", int(enc(R) * 255 + 0.5), int(enc(G) * 255 + 0.5), int(enc(B) * 255 + 0.5))
        }
        function hexlum(s) { return lum(lin(hex(s, 1)), lin(hex(s, 3)), lin(hex(s, 5))) }
        BEGIN {
            lbg = hexlum(bg)
            if (ratio(hexlum(h), lbg) >= want) { print h; exit }
            r = lin(hex(h, 1)); g = lin(hex(h, 3)); b = lin(hex(h, 5))
            l = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
            m = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
            s = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
            L0 = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
            A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
            Bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
            C0 = sqrt(A * A + Bb * Bb); H = atan2(Bb, A)
            for (L = L0; L > 0; L -= 0.002) {
                out = at(L)
                if (ratio(hexlum(out), lbg) >= want) break
            }
            print out
        }'
}

if [[ "$THEME_APPEARANCE" == "light" ]]; then
    for _c in FG FG_BRIGHT ACCENT BLUE RED GREEN YELLOW ORANGE PURPLE; do
        printf -v "$_c" '%s' "$(legible "${!_c}" "$BG" 4.5)"
        export "${_c?}"
    done
fi

# Muted text — comments, placeholders, inactive labels — is its own role, and
# BORDER is the wrong color for it: BORDER is tuned to sit close to BG so
# dividers stay quiet, which leaves it around 1.2-1.9:1 against the background
# on a light palette. Fade FG toward BG instead, stopping at the first step that
# still clears the 4.5:1 body-text floor, so the color is as quiet as it can be
# without becoming unreadable. The 0.85 cap keeps muted distinct from normal
# text when a theme's own FG sits so near the floor that nothing short of FG
# itself would clear it — that's the case to set MUTED by hand. A theme that
# does so (to reclaim its upstream comment hue) skips all of this.
if [[ -z "${MUTED:-}" ]]; then
    MUTED="$(awk \
        -v r1="$((16#${FG:0:2}))" -v g1="$((16#${FG:2:2}))" -v b1="$((16#${FG:4:2}))" \
        -v r0="$((16#${BG:0:2}))" -v g0="$((16#${BG:2:2}))" -v b0="$((16#${BG:4:2}))" '
        function lin(c,   x) { x = c / 255; return (x <= 0.04045) ? x / 12.92 : ((x + 0.055) / 1.055) ^ 2.4 }
        function lum(r, g, b) { return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }
        function ratio(a, b) { return (a > b) ? (a + 0.05) / (b + 0.05) : (b + 0.05) / (a + 0.05) }
        function mix(x, y, t) { return x * t + y * (1 - t) }
        BEGIN {
            lbg = lum(r0, g0, b0)
            t = 0.85
            for (i = 1; i <= 85; i++) {
                u = i / 100
                if (ratio(lum(mix(r1, r0, u), mix(g1, g0, u), mix(b1, b0, u)), lbg) >= 4.5) { t = u; break }
            }
            printf "%02x%02x%02x", \
                int(mix(r1, r0, t) + 0.5), int(mix(g1, g0, t) + 0.5), int(mix(b1, b0, t) + 0.5)
        }')"
fi
export MUTED

FG_SOFT="$(printf '%02x%02x%02x' \
    $(( (16#${FG:0:2} + 16#${MUTED:0:2}) / 2 )) \
    $(( (16#${FG:2:2} + 16#${MUTED:2:2}) / 2 )) \
    $(( (16#${FG:4:2} + 16#${MUTED:4:2}) / 2 )))"
export FG_SOFT
DERIVED+=(FG_SOFT)

for _c in "${PALETTE[@]}"; do
    _hex="${!_c}"
    printf -v "${_c}_RGB" '%d, %d, %d' \
        "$((16#${_hex:0:2}))" "$((16#${_hex:2:2}))" "$((16#${_hex:4:2}))"
    export "${_c}_RGB"
done

# Accent as HSL components (Obsidian's accent format)
ACCENT_H="" ACCENT_S="" ACCENT_L=""
if command -v python3 > /dev/null 2>&1; then
    read -r ACCENT_H ACCENT_S ACCENT_L <<< "$(python3 -c "
import colorsys
r, g, b = (int('$ACCENT'[i:i+2], 16) / 255 for i in (0, 2, 4))
h, l, s = colorsys.rgb_to_hls(r, g, b)
print(round(h * 360), round(s * 100), round(l * 100))")"
fi
export ACCENT_H ACCENT_S ACCENT_L

# --- font --------------------------------------------------------------------

# Orthogonal to the theme: fonts/<name>.sh + .current-font, switched by
# `dotfiles --font`, picked up by every render. Sizing knobs are optional in
# the preset — the defaults below keep the ghostty config valid either way.
FONT_FIELDS=(FONT_MONO_FAMILY FONT_TEXT_FAMILY FONT_SIZE FONT_CELL_HEIGHT FONT_CELL_WIDTH FONT_LINE_HEIGHT)

# shellcheck source=/dev/null
set -a
source "$DOTFILES/fonts/$(current_font).sh"
_text="$(current_text_font)"
# shellcheck source=/dev/null
[[ -n "$_text" ]] && source "$DOTFILES/fonts/text/$_text.sh"
set +a
export FONT_TEXT_FAMILY="${FONT_TEXT_FAMILY:-Helvetica Neue}"
export FONT_SIZE="${FONT_SIZE:-14}"
export FONT_CELL_HEIGHT="${FONT_CELL_HEIGHT:-0%}"
export FONT_CELL_WIDTH="${FONT_CELL_WIDTH:-0%}"
export FONT_LINE_HEIGHT="${FONT_LINE_HEIGHT:-1.4}" # zed buffer, as a multiplier
FONT_FEATURES_JSON="{$(for _f in ${FONT_FEATURES:-}; do printf '"%s": true, ' "$_f"; done | sed 's/, $//')}"
export FONT_FEATURES_JSON
FONT_FIELDS+=(FONT_FEATURES_JSON)

# --- template rendering ----------------------------------------------------

# Substitute only theme variables, so a literal $variable in a config file
# (waybar scripts, hyprland dispatchers) survives untouched.
VARS=""
for _v in "${PALETTE[@]}"; do VARS+="\${$_v}\${${_v}_RGB}"; done
for _v in "${THEME_FIELDS[@]}" "${FONT_FIELDS[@]}" "${DERIVED[@]}"; do VARS+="\${$_v}"; done

# envsubst ships with gettext, which stock macOS lacks — fall back to perl
if command -v envsubst &> /dev/null; then
    substitute() { envsubst "$VARS"; }
else
    substitute() {
        THEME_VARS="$VARS" perl -pe \
            's/\$\{(\w+)\}/(index($ENV{THEME_VARS}, "{$1}") >= 0 && defined $ENV{$1}) ? $ENV{$1} : $&/ge'
    }
fi

# --- helpers available to apps ---------------------------------------------

pretty() {
    local p="$1"
    p="${p#"$DOTFILES"/}"
    [[ "$p" == "$HOME"/* ]] && p="~${p#"$HOME"}"
    printf '%s' "$p"
}

note() { echo "    $1"; }
skip() { echo "    skipped: $1"; }

# Both take a template name relative to the app's own templates/ dir, and a
# destination that's either absolute (a live path outside the repo) or relative
# to the app's dir — in practice config/, which install.sh symlinks into place.
resolve() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s' "$APP_DIR/$1" ;;
    esac
}

generate() {
    local output; output="$(resolve "$2")"
    mkdir -p "$(dirname "$output")"
    substitute < "$APP_DIR/templates/$1" > "$output"
    note "wrote: $(pretty "$output")"
}

copy() {
    local output; output="$(resolve "$2")"
    mkdir -p "$(dirname "$output")"
    cp "$APP_DIR/templates/$1" "$output"
    note "wrote: $(pretty "$output")"
}

link() {
    [[ "$(readlink "$2" 2> /dev/null)" == "$1" ]] && return 0
    [[ -e "$2" || -L "$2" ]] && mv "$2" "$2.bak"
    ln -s "$1" "$2"
    note "linked: $(pretty "$2")"
}

# --- run the apps ----------------------------------------------------------

# Auto mode runs this on a timer while you also switch by hand, and two renders
# writing one config would interleave. mkdir is the atomic test-and-set that
# exists everywhere (macOS ships no flock).
LOCK="${TMPDIR:-/tmp}/dotfiles-switch-theme.lock"

# Don't let a run killed mid-render block every switch from here on.
if [[ -d "$LOCK" && -z "$(find "$LOCK" -maxdepth 0 -mmin -5 2> /dev/null)" ]]; then
    rmdir "$LOCK" 2> /dev/null || true
fi

if ! mkdir "$LOCK" 2> /dev/null; then
    echo "==> Another theme switch is already running; skipping."
    exit 0
fi
trap 'rmdir "$LOCK" 2> /dev/null || true' EXIT

echo "==> Switching to: $THEME"

for _dir in general "$PLATFORM"; do
    for APP_DIR in "$APPS_DIR/$_dir"/*/; do
        APP_DIR="${APP_DIR%/}"
        # Apps with no app.sh (yazi) are static config only — nothing
        # to render, install.sh just symlinks them.
        [[ -f "$APP_DIR/app.sh" ]] || continue
        echo "  $(basename "$APP_DIR")"

        # The subshell must not be the operand of `||` or `if`: bash suppresses
        # errexit inside one, so a half-failed render would carry on to reload.
        # Drop errexit around the call instead, and check the status by hand.
        set +e
        (
            set -e
            # shellcheck source=/dev/null
            source "$APP_DIR/app.sh"

            declare -f render > /dev/null && render

            [[ "$RELOAD" == 1 ]] || exit 0

            if declare -f "reload_$PLATFORM" > /dev/null; then
                "reload_$PLATFORM"
            elif declare -f reload > /dev/null; then
                reload
            fi
        )
        _status=$?
        set -e
        [[ "$_status" -eq 0 ]] || note "! failed (exit $_status)"
    done
done

echo "$THEME" > "$DOTFILES/.current-theme"

echo "==> Done. Active theme: $THEME"
